AI/uploads/
AI/chatbot/uploads/
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.aac
photos_video_demo/demo_PFE.mp4

# Binary executables and debug symbols
*.exe
*.dll
*.pdb
*.so
*.dylib

# Flutter / Dart build artifacts
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
Frontend-Mobile/build/
Frontend-Mobile/.dart_tool/
Frontend-Mobile/windows/flutter/ephemeral/
Frontend-Mobile/android/.gradle/
Frontend-Mobile/android/app/build/

# Logs
*.log
LOGs/
Backend/var/log/

# OS / IDE
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files
.env
.env.*
!.env.example

# Temporary and test artifacts
/tmp/
*.tmp
*.txt.bak
*.txt
!specs/**/*.txt
Backend/error.txt
Backend/test_*.php
Backend/test_*.txt
